---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <section class="mx-auto flex min-h-[80vh] max-w-xl flex-col items-center justify-center px-6 text-center">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-4 font-display text-5xl tracking-tight">This page drifted off.</h1>
    <p class="mt-4 text-muted">It may have moved, or never existed.</p>
    <a href="/" class="mt-8 rounded-full bg-ink px-6 py-3 text-sm font-medium text-bg transition hover:bg-accent">Back home</a>
  </section>
</Base>
