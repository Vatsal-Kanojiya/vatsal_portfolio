---
import ThemeToggle from './ThemeToggle.astro';
import ViewSwitch from './ViewSwitch.astro';
import profile from '../data/profile.json';
const links = [
  { href: '/#projects', label: 'Projects' },
  { href: '/#work', label: 'Work' },
  { href: '/#skills', label: 'Skills' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="fixed inset-x-0 top-0 z-40 print:hidden">
  <nav class="ui-pill mx-auto mt-3 flex max-w-5xl items-center justify-between rounded-full border border-line/70 bg-bg/90 px-4 py-2 md:bg-bg/70 md:backdrop-blur-md sm:px-5 mx-4 sm:mx-auto">
    <a href="/" class="font-display text-lg italic tracking-tight" aria-label="vatsal. Home">vatsal<span class="text-accent">.</span></a>
    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 sm:flex">
        {links.map((l) => (
          <li><a href={l.href} data-section={l.href.split('#')[1]} class="rounded-full px-3 py-1.5 text-sm text-muted transition hover:bg-accent-soft hover:text-ink aria-[current=true]:text-ink aria-[current=true]:bg-accent-soft/70">{l.label}</a></li>
        ))}
        <li><a href={profile.links.resume} download class="rounded-full px-3 py-1.5 text-sm text-muted transition hover:bg-accent-soft hover:text-ink">Résumé</a></li>
      </ul>
      <ViewSwitch />
      <ThemeToggle />
    </div>
  </nav>
</header>

<script>
  // On the home page, mark the nav link for the section in the middle of the screen
  const links = [...document.querySelectorAll<HTMLAnchorElement>('nav a[data-section]')];
  const sections = links.map((a) => document.getElementById(a.dataset.section!)).filter((s): s is HTMLElement => !!s);
  if (sections.length) {
    const visible = new Set<string>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id);
      const current = sections.find((s) => visible.has(s.id))?.id;
      links.forEach((a) => (a.dataset.section === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    }, { rootMargin: '-45% 0px -50% 0px' });
    sections.forEach((s) => io.observe(s));
  }
</script>
