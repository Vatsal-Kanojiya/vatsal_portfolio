---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import profile from '../data/profile.json';

// Drop a file named portrait.(jpg|png|webp) into src/assets/photos/ and it appears here.
const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/portrait.{jpg,jpeg,png,webp}', { eager: true });
const portrait = Object.values(portraits)[0]?.default;
const [first, ...rest] = profile.name.split(' ');
---
<section class="relative isolate flex min-h-[100svh] items-center overflow-hidden">
  <canvas id="flow" class="absolute inset-0 -z-10 h-full w-full" aria-hidden="true"></canvas>
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_70%_45%,transparent_35%,var(--bg)_85%)]"></div>

  <div class="mx-auto grid w-full max-w-5xl items-center gap-12 px-6 pt-28 pb-20 md:grid-cols-[1.4fr_1fr]">
    <div>
      <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-3 py-1 text-xs text-muted backdrop-blur" data-reveal>
        <span class="relative flex size-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span><span class="relative inline-flex size-2 rounded-full bg-accent"></span></span>
        {profile.openTo}
      </p>
      <h1 class="font-display text-6xl leading-[.95] tracking-tight sm:text-7xl md:text-8xl" aria-label={profile.name}>
        <span class="name-line">{[...first].map((c, i) => <span style={`--i:${i}`}>{c}</span>)}</span><br />
        <span class="name-line italic text-accent">{[...rest.join(' ')].map((c, i) => <span style={`--i:${i + first.length}`}>{c}</span>)}</span>
      </h1>
      <p class="mt-6 font-mono text-sm uppercase tracking-[.18em] text-muted" data-reveal style="--d:160ms">
        {profile.role} · {profile.location.split(',')[0]} · <time id="local-time" class="text-ink">--:--</time> IST
      </p>
      <p class="mt-8 max-w-xl font-display text-2xl leading-snug italic sm:text-3xl" data-reveal style="--d:240ms">{profile.headline}</p>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted" data-reveal style="--d:320ms">{profile.intro}</p>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--d:400ms">
        <a href="#projects" class="group inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3 text-sm font-medium text-bg transition hover:bg-accent">
          See my projects <span class="transition group-hover:translate-x-1">→</span>
        </a>
        <a href={profile.links.resume} download class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-6 py-3 text-sm font-medium backdrop-blur transition hover:border-accent hover:text-accent">
          Download résumé
        </a>
      </div>
    </div>

    {portrait ? (
      <div class="relative mx-auto w-56 sm:w-72" data-reveal style="--d:300ms">
        <div class="absolute -inset-3 rounded-[2rem] border border-accent/30 rotate-3"></div>
        <Image src={portrait} alt={`Portrait of ${profile.name}`} widths={[320, 640]} sizes="18rem" class="relative aspect-[4/5] rounded-[1.75rem] object-cover shadow-xl" loading="eager" />
      </div>
    ) : <div class="hidden md:block"></div>}
  </div>

  <a href="#journey" class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 font-mono sm:block text-[11px] uppercase tracking-[.3em] text-muted transition hover:text-accent" aria-label="Scroll to journey">
    scroll<span class="mx-auto mt-2 block h-8 w-px animate-pulse bg-current"></span>
  </a>
</section>

<style>
  .name-line > span { display: inline-block; opacity: 0; transform: translateY(.35em) rotate(4deg); filter: blur(6px);
    animation: letter-in 1s cubic-bezier(.2,.7,.2,1) forwards; animation-delay: calc(var(--i) * 45ms + 150ms); }
  @keyframes letter-in { to { opacity: 1; transform: none; filter: none; } }
  @media (prefers-reduced-motion: reduce) { .name-line > span { animation: none; opacity: 1; transform: none; filter: none; } }
</style>

<script>
  // Live Bengaluru clock — a small, human detail.
  const clock = document.getElementById('local-time');
  const tick = () => { if (clock) clock.textContent = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Kolkata' }).format(new Date()); };
  tick(); setInterval(tick, 20_000);
</script>

<script>
  // Streamlines: particles drifting through a slow vector field —
  // a quiet nod to fluid & thermal flow, where this engineer started.
  const canvas = document.getElementById('flow') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w = 0, h = 0, dpr = 1, t = 0, raf = 0, running = false;
    let ps: { x: number; y: number; age: number; life: number }[] = [];
    const mouse = { x: -9999, y: -9999 };
    const accent = () => getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#2c6b5e';
    let color = accent();

    const spawn = () => ({ x: Math.random() * w, y: Math.random() * h, age: 0, life: 120 + Math.random() * 220 });
    const resize = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.min(420, Math.floor((w * h) / 4200));
      ps = Array.from({ length: n }, spawn);
    };
    const angle = (x: number, y: number) =>
      Math.sin(x * 0.0018 + t * 0.00035) * 1.3 +
      Math.cos(y * 0.0022 - t * 0.0003) * 1.1 +
      Math.sin((x + y) * 0.0009) * 0.7;

    const step = () => {
      t++;
      ctx.globalCompositeOperation = 'destination-out';
      ctx.fillStyle = 'rgba(0,0,0,0.018)';
      ctx.fillRect(0, 0, w, h);
      ctx.globalCompositeOperation = 'source-over';
      ctx.strokeStyle = color;
      ctx.globalAlpha = 0.5;
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (const p of ps) {
        let a = angle(p.x, p.y);
        const dx = p.x - mouse.x, dy = p.y - mouse.y, d2 = dx * dx + dy * dy;
        if (d2 < 22000) a += (1 - d2 / 22000) * 2.2; // gentle swirl around the cursor
        const nx = p.x + Math.cos(a) * 0.9, ny = p.y + Math.sin(a) * 0.9;
        ctx.moveTo(p.x, p.y); ctx.lineTo(nx, ny);
        p.x = nx; p.y = ny; p.age++;
        if (p.age > p.life || nx < 0 || ny < 0 || nx > w || ny > h) Object.assign(p, spawn());
      }
      ctx.stroke();
      ctx.globalAlpha = 1;
    };
    const loop = () => { step(); raf = requestAnimationFrame(loop); };
    const start = () => { if (!running && !reduce) { running = true; loop(); } };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    resize();
    if (reduce) for (let i = 0; i < 220; i++) step(); // one still frame
    else start();

    addEventListener('resize', () => { resize(); if (reduce) for (let i = 0; i < 220; i++) step(); });
    canvas.parentElement?.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect(); mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
    });
    canvas.parentElement?.addEventListener('pointerleave', () => { mouse.x = mouse.y = -9999; });
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    new MutationObserver(() => { color = accent(); ctx.clearRect(0, 0, w, h); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>
