---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import ProjectVisual from './ProjectVisual.astro';
import { visible } from '../lib/site';
import profile from '../data/profile.json';

const all = (await getCollection('projects', visible)).sort((a, b) => a.data.order - b.data.order);
const showcase = all.filter((p) => p.data.kind === 'showcase');
const more = all.filter((p) => p.data.kind === 'more');
const statusLabel = { live: 'Live', 'in-progress': 'In progress', archived: 'Archived' } as const;
---
<section id="projects" class="mx-auto max-w-5xl px-6 py-28">
  <SectionHead index="01" eyebrow="Projects" title="Systems in production,<br/><em class='text-accent'>and what I build after hours.</em>"
    lead={`${profile.workSummary} The two client flagships and two products of my own come first. Client names are withheld; the engineering is shown in full.`}
    note={profile.paper.notes.projects} />

  <div class="space-y-8">
    {showcase.map(({ id, data }, i) => (
      <article class="ui-card group relative grid overflow-hidden rounded-3xl border border-line bg-surface transition duration-500 hover:-translate-y-1 hover:border-accent/50 hover:shadow-[0_30px_60px_-30px_var(--accent)] md:grid-cols-[1fr_1.4fr]"
        data-reveal style={`--d:${i * 80}ms`}>
        <div class="relative aspect-[16/9] overflow-hidden md:aspect-auto md:min-h-80">
          {data.cover
            ? <Image src={data.cover} alt={`${data.title} screenshot`} widths={[640, 1280]} sizes="(min-width: 768px) 26rem, 100vw" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" />
            : <ProjectVisual title={data.title} seed={i + 3} class="h-full w-full transition duration-700 group-hover:scale-[1.03]" />}
        </div>
        <div class="flex flex-col p-7 sm:p-9">
          <div class="mb-4 flex flex-wrap items-center gap-2">
            <span class="ui-pill inline-flex items-center gap-2 rounded-full border border-line px-2.5 py-0.5 font-mono text-[11px] uppercase tracking-wider text-muted">
              <span class={`size-1.5 rounded-full ${data.status === 'live' || data.statusLabel?.startsWith('In production') ? 'bg-accent' : 'bg-warm'}`}></span>{data.statusLabel ?? statusLabel[data.status]}
            </span>
          </div>
          <h3 class="font-display text-3xl tracking-tight">
            <a href={`/projects/${id}/`} class="after:absolute after:inset-0">{data.title}</a>
          </h3>
          <p class="mt-1 font-display text-xl italic text-accent">{data.tagline}</p>
          <ul class="mt-5 space-y-3 text-[15px] leading-relaxed">
            {data.points.map((p) => (
              <li class="flex gap-3"><span class="mt-[.7em] h-px w-3 shrink-0 bg-accent"></span><span>{p}</span></li>
            ))}
          </ul>
          {data.note && <p class="mt-5 text-sm leading-relaxed text-muted italic">{data.note}</p>}
          <ul class="mt-6 flex flex-wrap gap-1.5">
            {data.stack.map((s) => <li class="ui-pill rounded-full bg-accent-soft px-2.5 py-0.5 font-mono text-[11px] text-accent">{s}</li>)}
          </ul>
          <div class="mt-auto flex flex-wrap items-center gap-x-6 gap-y-2 pt-8 text-sm font-medium">
            <span>Read the case study <span class="inline-block transition group-hover:translate-x-1">→</span></span>
            {data.repo && <a href={data.repo} target="_blank" rel="noopener" class="relative z-10 text-muted transition hover:text-accent">Source on GitHub ↗</a>}
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="mt-20" data-reveal>
    <p class="font-mono text-xs uppercase tracking-[.2em] text-accent">More client work</p>
    <h3 class="mt-3 font-display text-3xl tracking-tight sm:text-4xl">Every system I've shipped, <em class="text-accent">in brief.</em></h3>
    <p class="mt-3 max-w-2xl text-muted">Open a row for one operations, one dashboard or report, and one engineering highlight.</p>
  </div>
  <div class="ui-card mt-8 divide-y divide-line overflow-hidden rounded-3xl border border-line bg-surface" data-reveal>
    {more.map(({ id, data }) => (
      <details class="group/row">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 p-6 transition hover:bg-accent-soft/40 sm:items-center sm:p-7 [&::-webkit-details-marker]:hidden">
          <span class="flex min-w-0 flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
            <span class="font-display text-xl tracking-tight sm:shrink-0 sm:text-2xl">{data.title}</span>
            <span class="text-sm text-muted">{data.tagline}</span>
          </span>
          <span class="flex shrink-0 items-center gap-3">
            <span class="ui-pill hidden rounded-full border border-line px-2.5 py-0.5 font-mono text-[11px] uppercase tracking-wider text-muted md:inline">{data.statusLabel ?? statusLabel[data.status]}</span>
            <span class="font-mono text-xl text-accent transition group-open/row:rotate-45" aria-hidden="true">+</span>
          </span>
        </summary>
        <div class="px-6 pb-7 sm:px-7">
          <p class="ui-pill mb-4 inline-block rounded-full border border-line px-2.5 py-0.5 font-mono text-[11px] uppercase tracking-wider text-muted md:hidden">{data.statusLabel ?? statusLabel[data.status]}</p>
          <ul class="space-y-3 text-[15px] leading-relaxed">
            {data.points.map((p) => {
              const m = p.match(/^(Operations|Dashboards|Reports|Engineering): (.*)$/);
              return (
                <li class="grid gap-1 sm:grid-cols-[7.5rem_1fr] sm:gap-4">
                  <span class="font-mono text-[11px] uppercase tracking-wider text-accent sm:pt-1">{m ? m[1] : ''}</span>
                  <span>{m ? m[2][0].toUpperCase() + m[2].slice(1) : p}</span>
                </li>
              );
            })}
          </ul>
          {data.note && <p class="mt-4 text-sm italic text-muted">{data.note}</p>}
          <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
            <ul class="flex flex-wrap gap-1.5">
              {data.stack.map((s) => <li class="ui-pill rounded-full border border-line px-2.5 py-0.5 font-mono text-[11px] text-muted">{s}</li>)}
            </ul>
            <a href={`/projects/${id}/`} class="text-sm font-medium transition hover:text-accent">Read more →</a>
          </div>
        </div>
      </details>
    ))}
  </div>

  <div class="mt-20" data-reveal>
    <p class="font-mono text-xs uppercase tracking-[.2em] text-accent">Reusable apps</p>
    <h3 class="mt-3 font-display text-3xl tracking-tight sm:text-4xl">Built once, <em class="text-accent">installed across client projects.</em></h3>
  </div>
  <ul class="mt-8 grid gap-4 md:grid-cols-3">
    {profile.apps.map((a, i) => (
      <li class="ui-card ui-tape group relative flex flex-col rounded-2xl border border-line bg-surface p-6 transition hover:border-accent/50" data-reveal style={`--d:${i * 80}ms`}>
        <p class="font-mono text-[11px] uppercase tracking-wider text-muted">{a.role ?? 'Installed across client projects'}</p>
        <h4 class="mt-2 font-display text-2xl tracking-tight">
          {a.href ? <a href={a.href} class="after:absolute after:inset-0 transition group-hover:text-accent">{a.title} <span class="text-base">→</span></a> : a.title}
        </h4>
        <p class="mt-3 text-[15px] leading-relaxed">{a.text}</p>
        {a.plug && <p class="mt-auto pt-4 text-sm leading-relaxed text-muted">{a.plug}</p>}
      </li>
    ))}
  </ul>
</section>
