---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import ProjectVisual from './ProjectVisual.astro';
import { visible } from '../lib/site';

const all = (await getCollection('projects', visible)).sort((a, b) => a.data.order - b.data.order);
const showcase = all.filter((p) => p.data.kind === 'showcase');
const early = all.filter((p) => p.data.kind === 'early');
const statusLabel = { live: 'Live', 'in-progress': 'In progress', archived: 'Archived' } as const;

// Growth strip: oldest to newest, with what each step added
const steps = [
  { title: 'To-Do List', year: '2023', added: 'Models, forms, templates' },
  { title: 'VBlog', year: '2023', added: 'Auth, social features, payments' },
  { title: 'Expense Tracker', year: '2026', added: 'Concurrency, background jobs, APIs, Docker' },
  { title: 'Super Notes', year: '2026', added: 'AI search and chat, sync, mobile' },
];
---
<section id="projects" class="mx-auto max-w-5xl px-6 py-28">
  <SectionHead index="03" eyebrow="Projects" title="Things I build<br/><em class='text-accent'>on my own time.</em>"
    lead="Personal projects, built to production standards. Open one to see everything it does." />

  <div class="space-y-8">
    {showcase.map(({ id, data }, i) => (
      <a href={`/projects/${id}/`} class="group grid overflow-hidden rounded-3xl border border-line bg-surface transition duration-500 hover:-translate-y-1 hover:border-accent/50 hover:shadow-[0_30px_60px_-30px_var(--accent)] md:grid-cols-[1fr_1.1fr]"
        data-reveal style={`--d:${i * 80}ms`}>
        <div class="relative aspect-[16/10] overflow-hidden md:aspect-auto md:min-h-80">
          {data.cover
            ? <Image src={data.cover} alt={`${data.title} screenshot`} widths={[640, 1280]} sizes="(min-width: 768px) 30rem, 100vw" class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" />
            : <ProjectVisual title={data.title} seed={i + 3} class="h-full w-full transition duration-700 group-hover:scale-[1.03]" />}
        </div>
        <div class="flex flex-col p-7 sm:p-9">
          <div class="mb-4 flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-2 rounded-full border border-line px-2.5 py-0.5 font-mono text-[11px] uppercase tracking-wider text-muted">
              <span class={`size-1.5 rounded-full ${data.status === 'live' ? 'bg-accent' : 'bg-warm'}`}></span>{statusLabel[data.status]}
            </span>
            {data.platforms.map((p) => <span class="rounded-full bg-accent-soft px-2.5 py-0.5 font-mono text-[11px] text-accent">{p}</span>)}
          </div>
          <h3 class="font-display text-3xl tracking-tight">{data.title}</h3>
          <p class="mt-1 font-display text-xl italic text-accent">{data.tagline}</p>
          <p class="mt-4 leading-relaxed text-muted">{data.summary}</p>
          <ul class="mt-5 grid gap-x-4 gap-y-1.5 text-sm sm:grid-cols-2">
            {data.features.slice(0, 6).map((f) => (
              <li class="flex gap-2"><span class="mt-[.55em] h-px w-3 shrink-0 bg-accent"></span>{f.title}</li>
            ))}
          </ul>
          <span class="mt-auto pt-8 text-sm font-medium">See everything it does <span class="inline-block transition group-hover:translate-x-1">→</span></span>
        </div>
      </a>
    ))}
  </div>

  <!-- Growth -->
  <div class="mt-24" data-reveal>
    <p class="font-mono text-xs uppercase tracking-[.2em] text-accent">Three years of growth</p>
    <h3 class="mt-3 font-display text-3xl tracking-tight sm:text-4xl">Where it started, <em class="text-accent">and where it is now.</em></h3>
  </div>
  <div class="relative mt-10">
  <span class="absolute top-[7px] right-0 left-0 hidden h-px bg-gradient-to-r from-line via-accent/60 to-accent sm:block"></span>
  <ol class="relative grid gap-6 sm:grid-cols-4">
    {steps.map((s, i) => (
      <li class="relative pl-6 sm:pl-0 sm:pt-8" data-reveal style={`--d:${i * 90}ms`}>
        <span class={`absolute top-1 left-0 size-[15px] rounded-full border-2 sm:top-0 ${i === steps.length - 1 ? 'border-accent bg-accent ring-4 ring-accent/20' : i >= 2 ? 'border-accent bg-accent' : 'border-muted bg-bg'}`}></span>
        <p class="font-mono text-xs text-muted">{s.year}</p>
        <p class="mt-1 font-display text-xl tracking-tight">{s.title}</p>
        <p class="mt-1 text-sm leading-snug text-muted">{s.added}</p>
      </li>
    ))}
  </ol>
  </div>

  <div class="mt-12 grid gap-4 sm:grid-cols-2">
    {early.map(({ data }, i) => (
      <a href={data.repo} target="_blank" rel="noopener" class="group rounded-2xl border border-dashed border-line p-6 transition hover:border-accent/60 hover:bg-surface"
        data-reveal style={`--d:${i * 80}ms`}>
        <p class="font-mono text-xs text-muted">{data.year} · early work</p>
        <h4 class="mt-2 font-display text-2xl tracking-tight">{data.title} <span class="text-base text-muted transition group-hover:text-accent">↗</span></h4>
        <p class="mt-1 text-accent">{data.tagline}</p>
        <p class="mt-3 text-[15px] leading-relaxed text-muted">{data.summary}</p>
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {data.stack.map((s) => <li class="rounded-full bg-surface px-2.5 py-0.5 font-mono text-[11px] text-muted group-hover:bg-bg">{s}</li>)}
        </ul>
      </a>
    ))}
  </div>
</section>
