---
import { views } from '../lib/views';
---
<div class="relative" id="view-switch">
  <button id="view-btn" type="button" aria-expanded="false" aria-controls="view-menu" aria-label="Change view"
    class="ui-pill flex h-9 items-center gap-1.5 rounded-full px-2.5 text-sm text-muted transition hover:bg-accent-soft hover:text-ink">
    <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M12 3a9 9 0 1 0 0 18c1 0 1.6-.8 1.6-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.8-1.7 1.7-1.7H16a5 5 0 0 0 5-5c0-4-4-7.2-9-7.2z"/>
      <circle cx="7.5" cy="11" r="1"/><circle cx="10.5" cy="7.5" r="1"/><circle cx="15" cy="7.5" r="1"/>
    </svg>
    {views.map((v) => <span class="hidden md:inline" data-only={v.id}>{v.label}</span>)}
  </button>
  <div id="view-menu" hidden
    class="ui-card absolute top-full right-0 mt-2 w-60 rounded-2xl border border-line bg-bg p-1.5 shadow-[0_20px_40px_-20px_rgb(0_0_0/.35)]">
    <p class="px-3 pt-1.5 pb-1 text-xs text-muted">Same content, different look</p>
    <ul>
      {views.map((v) => (
        <li>
          <button type="button" data-set-view={v.id} aria-pressed="false"
            class="group flex w-full items-center justify-between gap-3 rounded-xl px-3 py-2 text-left transition hover:bg-accent-soft aria-pressed:bg-accent-soft">
            <span>
              <span class="block text-[15px] text-ink" style={v.previewFont && `font-family:${v.previewFont};font-size:1.15em;font-size-adjust:ex-height .5;line-height:1.2`}>{v.label}</span>
              <span class="block text-xs text-muted">{v.hint}</span>
            </span>
            <span class="text-accent opacity-0 group-aria-pressed:opacity-100" aria-hidden="true">✓</span>
          </button>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  import { views } from '../lib/views';

  const root = document.documentElement;
  const btn = document.getElementById('view-btn')!;
  const menu = document.getElementById('view-menu')!;
  const options = [...menu.querySelectorAll<HTMLButtonElement>('[data-set-view]')];

  const sync = () => options.forEach((o) => o.setAttribute('aria-pressed', String(o.dataset.setView === root.dataset.view)));
  const open = (yes: boolean) => { menu.hidden = !yes; btn.setAttribute('aria-expanded', String(yes)); if (yes) sync(); };

  async function setView(id: string) {
    open(false);
    if (id === root.dataset.view) return;
    try { localStorage.setItem('view', id); } catch {}
    // Keep a shared ?view= link in step with the choice, so a reload doesn't switch back
    const url = new URL(location.href);
    if (url.searchParams.has('view')) { url.searchParams.set('view', id); history.replaceState(history.state, '', url); }
    // Fetch the view's fonts first (briefly), so it appears with its type already in place
    const fonts = views.find((v) => v.id === id)?.fonts ?? [];
    await Promise.race([Promise.all(fonts.map((f) => document.fonts.load(f))).catch(() => {}), new Promise((r) => setTimeout(r, 700))]);
    const apply = () => { root.dataset.view = id; };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (document.startViewTransition && !reduce) document.startViewTransition(apply);
    else apply();
  }

  btn.addEventListener('click', () => open(Boolean(menu.hidden)));
  options.forEach((o) => o.addEventListener('click', () => setView(o.dataset.setView!)));
  document.addEventListener('click', (e) => { if (!menu.hidden && !document.getElementById('view-switch')!.contains(e.target as Node)) open(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { open(false); btn.focus(); } });
</script>
