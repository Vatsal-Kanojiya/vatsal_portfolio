---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import JourneyTrack from './JourneyTrack.astro';
import { visible } from '../lib/site';
import profile from '../data/profile.json';

const entries = (await getCollection('journey', visible)).sort((a, b) => a.data.order - b.data.order);
const items = await Promise.all(entries.map(async (e) => ({ ...e, Content: (await render(e)).Content })));

const dot: Record<string, string> = {
  foundation: 'bg-bg border-muted',
  work: 'bg-accent border-accent',
  pivot: 'bg-warm border-warm',
  now: 'bg-accent border-accent ring-4 ring-accent/20',
};
---
<section id="journey" class="mx-auto max-w-5xl px-6 py-28">
  <SectionHead index="01" eyebrow="Journey" title="From machines<br/><em class='text-accent'>to systems.</em>"
    lead="An engineer first, by training. A software engineer by choice. Each step added something I still use."
    note={profile.paper.notes.journey} />

  <JourneyTrack>
    <ol class="space-y-14">
      {items.map(({ data, Content }, i) => (
        <li class="relative grid gap-3 pl-10 md:grid-cols-[9rem_1fr] md:gap-10 md:pl-0" data-reveal style={`--d:${(i % 3) * 60}ms`}>
          <span class={`ui-dot absolute top-1.5 left-0 size-[15px] rounded-full border-2 md:left-[9rem] ${dot[data.kind]}`}></span>
          <p class="pt-0.5 font-mono text-xs uppercase tracking-[.15em] text-muted md:pr-6 md:text-right">{data.period}</p>
          <div class="md:pl-10">
            <h3 class="font-display text-2xl tracking-tight">{data.title}</h3>
            {data.place && <p class="mt-1 text-sm text-accent">{data.place}</p>}
            <div class="mt-3 max-w-xl leading-relaxed text-muted"><Content /></div>
            {data.image && (
              <Image src={data.image} alt={data.imageAlt ?? data.title} widths={[480, 960]} sizes="(min-width: 768px) 36rem, 100vw"
                class="ui-photo mt-5 aspect-[16/9] w-full max-w-xl rounded-2xl border border-line object-cover" />
            )}
          </div>
        </li>
      ))}
    </ol>
  </JourneyTrack>
</section>
