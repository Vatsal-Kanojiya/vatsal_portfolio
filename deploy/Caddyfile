# One server, many sites. Caddy fetches and renews HTTPS certificates by itself.
# DOMAIN comes from deploy/.env, e.g. DOMAIN=vatsalkanojiya.dev

{$DOMAIN} {
	root * /srv/portfolio
	encode zstd gzip
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

